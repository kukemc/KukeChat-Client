{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KukeChat",
  "version": "1.2.1",
  "identifier": "ink.kuke.chat",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:desktop-web",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "KukeChat",
        "url": "index.desktop.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
