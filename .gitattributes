# 统一以 LF 入库，避免跨平台协作时出现整文件 diff
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Gradle wrapper 在 Linux/macOS 上必须是 LF，否则无法执行
gradlew text eol=lf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.ttf     binary
*.woff2   binary
*.mp3     binary
*.wav     binary
*.jar     binary
*.keystore binary
